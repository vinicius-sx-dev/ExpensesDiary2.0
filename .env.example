ENVIRONMENT=development
# Use URL-encoded credentials. Create a dedicated database and restricted DB user.
DATABASE_URL=
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
ALLOWED_HOSTS=["localhost","127.0.0.1","192.168.1.10"]
CORS_ORIGINS=["http://localhost:8081"]
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Production defaults to closed registration; read docs/DEPLOY.md before opting in.
# REGISTRATION_ENABLED=false
AI_GLOBAL_HOURLY_LIMIT=100

# Generate independently: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
STATEMENT_ENCRYPTION_KEY=
# Required in production. PEM CA that signs the MySQL server certificate.
DATABASE_SSL_CA=
IMPORT_GLOBAL_HOURLY_LIMIT=300

# Simulação explicitamente habilitada, bloqueada em produção.
PLUGGY_MOCK_ENABLED=false
# Reservados para implementação futura do adaptador real. Nunca enviar ao mobile.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=

# Advisor: no price provider is enabled until an authorized regional feed is configured.
# Server-only fixed HTTPS endpoint. Must implement docs/ADVISOR.md Quote contract.
ADVISOR_PRICE_FEED_URL=
ADVISOR_PRICE_FEED_TOKEN=
# Enable only after EAS/FCM/APNs and Expo enhanced push security are configured.
ADVISOR_PUSH_ENABLED=
EXPO_ACCESS_TOKEN=
