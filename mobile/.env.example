# Android emulator: http://10.0.2.2:8000 ; device: LAN address of your computer.
# Production requires HTTPS. Never place credentials in EXPO_PUBLIC variables.
EXPO_PUBLIC_API_URL=http://192.168.1.10:8000

# Public project identifier, not a credential. Create/configure your own EAS project.
EXPO_PUBLIC_EAS_PROJECT_ID=
# GOOGLE_SERVICES_FILE is supplied to the build environment; never commit credentials.
